[
  {
    "category": "pattern",
    "name": "Plain",
    "defaultParams": {
      "patternTag": 1,
      "tsTag": 1,
      "fact": 1.0
    },
    "command": {
      "name": "pattern",
      "args": ["Plain", "$patternTag", "$tsTag", "-fact", "$fact"]
    }
  },
  {
    "category": "load",
    "name": "PointLoad",
    "defaultParams": {
      "nodeTag": 1,
      "loadValues": [0.0, -1000.0, 0.0]
    },
    "command": {
      "name": "load",
      "args": ["$nodeTag", "*$loadValues"]
    }
  },
  {
    "category": "load",
    "name": "GravityLoad",
    "defaultParams": {
      "nodeTag": 1,
      "loadValues": [0.0, -9.81, 0.0]
    },
    "command": {
      "name": "load",
      "args": ["$nodeTag", "*$loadValues"]
    }
  },
  {
    "category": "sp",
    "name": "SPConstraint",
    "defaultParams": {
      "nodeTag": 1,
      "dof": 2,
      "dofValue": 0.0
    },
    "command": {
      "name": "sp",
      "args": ["$nodeTag", "$dof", "$dofValue"]
    }
  },
  {
    "category": "pattern",
    "name": "UniformExcitation",
    "defaultParams": {
      "patternTag": 2,
      "dir": 1,
      "dispSeriesTag": null,
      "velSeriesTag": null,
      "accelSeriesTag": 3,
      "vel0": 0.0,
      "fact": 1.0
    },
    "command": {
      "name": "pattern",
      "args": [
        "UniformExcitation",
        "$patternTag",
        "$dir",
        "-disp", "$dispSeriesTag",
        "-vel", "$velSeriesTag",
        "-accel", "$accelSeriesTag",
        "-vel0", "$vel0",
        "-fact", "$fact"
      ]
    }
  },
  {
    "category": "pattern",
    "name": "MultipleSupport",
    "defaultParams": {
      "patternTag": 3
    },
    "command": {
      "name": "pattern",
      "args": ["MultipleSupport", "$patternTag"]
    }
  },
  {
    "category": "eleLoad",
    "name": "BeamPointLoad",
    "defaultParams": {
      "eleTags": [1],        
      "useRange": false,    
      "eleTag1": 1,
      "eleTag2": 1,
      "Pz": -1000.0,
      "xL": 0.5,
      "Px": 0.0              
    },
    "command": {
      "name": "eleLoad",
      "args": [

        { "cond": "!$useRange", "value": ["-ele", "*$eleTags"] },
        { "cond": "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "-beamPoint",
        "$Pz", "$xL",
      
        "$Px"
      ]
    }
  },
  {
    "category": "eleLoad",
    "name": "BeamUniformLoad",
    "defaultParams": {
      "eleTags": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Wz": -5000.0,
      "Wx": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$eleTags"] },
        { "cond": "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "-beamUniform",
        "$Wz",
   
        "$Wx"
      ]
    }
  },
  {
    "category": "eleLoad",
    "name": "BeamTrapezoidalLoad",
    "defaultParams": {
      "eleTags": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Wz_start": -2000.0,
      "Wx_start": 0.0,
      "aL": 0.2,
      "bL": 0.9,
      "Wz_end": -4000.0,
      "Wx_end": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$eleTags"] },
        { "cond": "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "-beamUniform",
        "$Wz_start", "$Wx_start", "$aL", "$bL", "$Wz_end", "$Wx_end"
      ]
    }
  }


]
