[
  {
    "category": "pattern",
    "name": "Plain",
    "defaultParams": {
      "Pattern ID": 1
    },
    "command": {
      "name": "pattern",
      "args": ["Plain", "$Pattern ID", 1, "-fact", 1.0]
    }
  },
  {
    "category": "load",
    "name": "Truss Nodal Load",
    "defaultParams": {
      "Node ID": 1,
      "X Load (kN)": 0.0,
      "Y Load (kN)": 0.0
    },
    "command": {
      "name": "load",
      "args": ["$Node ID", "$X Load (kN)", "$Y Load (kN)"]
    }
  },
  {
    "category": "load",
    "name": "Frame Nodal Load",
    "defaultParams": {
      "Node ID": 1,
      "X Load (kN)": 0.0,
      "Y Load (kN)": 0.0,
      "Moment (kN-m)":0.0

    },
    "command": {
      "name": "load",
      "args": ["$Node ID", "$X Load (kN)", "$Y Load (kN)", "$Moment (kN-m)"]
    }
  },


  {
    "category": "eleLoad",
    "name": "BeamUniformLoad",
    "defaultParams": {
      "Element ID's": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Wy (kN/m)": -5.0,
      "Wx (kN/m)": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$Element ID's"] },
        { "cond":  "$useRange", "value": ["-range", "$Element ID 1", "$Element ID 2"] },
        "-type", "beamUniform",
        "$Wy (kN/m)",
        "$Wx (kN/m)"
      ]
    }
  },
  {
    "category": "eleLoad",
    "name": "BeamPointLoad",
    "defaultParams": {
      "Element ID's": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Py (kN)": -1.0,
      "Location (0 → 1)": 0.5,
      "Px (kN)": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$Element ID's"] },
        { "cond":  "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "beamPoint",
        "$Py (kN)",
        "$Location (0 → 1)",
        "$Px (kN)"
      ]
    }
  },
  {
    "category": "eleLoad",
    "name": "BeamTrapezoidalLoad",
    "defaultParams": {
      "Element ID's": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Wy start (kN/m)": -2.0,
      "Wx start (kN/m)": 0.0,
      "Starting (0 → 1)": 0.2,
      "Ending (0 → 1)": 0.9,
      "Wy end (kN/m)": -4.0,
      "Wx end (kN/m)": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$Element ID's"] },
        { "cond":  "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "beamUniform",
        "$Wy start (kN/m)",
        "$Wx start (kN/m)",
        "$Starting (0 → 1)",
        "$Ending (0 → 1)",
        "$Wy end (kN/m)",
        "$Wx end (kN/m)"
      ]
    }
  }
]
