[
  {
    "category": "pattern",
    "name": "Plain",
    "defaultParams": {
      "Pattern ID": 1
    },
    "command": {
      "name": "pattern",
      "args": ["Plain", "$Pattern ID", 1, "-fact", 1.0]
    }
  },
  {
    "category": "load",
    "name": "Truss Nodal Load",
    "tag":"truss",
    "defaultParams": {
      "Node ID": 1,
      "X Load": 0.0,
      "Y Load": 0.0
    },
    "command": {
      "name": "load",
      "args": ["$Node ID", "$X Load", "$Y Load"]
    }
  },
  {
    "category": "load",
    "name": "Frame Nodal Load",
    "tag":"frame",
    "defaultParams": {
      "Node ID": 1,
      "X Load": 0.0,
      "Y Load": 0.0,
      "Moment":0.0

    },
    "command": {
      "name": "load",
      "args": ["$Node ID", "$X Load", "$Y Load", "$Moment"]
    }
  },


  {
    "category": "eleLoad",
    "name": "Uniform Load (UDL)",
    "tag":"frame",
    "defaultParams": {
      "Element ID's": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Wy": -5.0,
      "Wx": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$Element ID's"] },
        { "cond":  "$useRange", "value": ["-range", "$Element ID 1", "$Element ID 2"] },
        "-type", "beamUniform",
        "$Wy",
        "$Wx"
      ]
    }
  },
  {
    "category": "eleLoad",
    "name": "Point Load on Element",
    "tag":"frame",
    "defaultParams": {
      "Element ID's": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Py": -1.0,
      "Location (0 → 1)": 0.5,
      "Px": 0.0
    },
    "command": {
      "name": "eleLoad",
      
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$Element ID's"] },
        { "cond":  "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "beamPoint",
        "$Py",
        "$Location (0 → 1)",
        "$Px"
      ]
    }
  },
  {
    "category": "eleLoad",
    "name": "Trapezoidal Load (VDL)",
    "tag":"frame",
    "defaultParams": {
      "Element ID's": [1],
      "useRange": false,
      "eleTag1": 1,
      "eleTag2": 1,
      "Wy start": -2.0,
      "Wx start": 0.0,
      "Starting (0 → 1)": 0.2,
      "Ending (0 → 1)": 0.9,
      "Wy end": -4.0,
      "Wx end": 0.0
    },
    "command": {
      "name": "eleLoad",
      "args": [
        { "cond": "!$useRange", "value": ["-ele", "*$Element ID's"] },
        { "cond":  "$useRange", "value": ["-range", "$eleTag1", "$eleTag2"] },
        "-type", "beamUniform",
        "$Wy start",
        "$Wx start",
        "$Starting (0 → 1)",
        "$Ending (0 → 1)",
        "$Wy end",
        "$Wx end"
      ]
    }
  }
]
