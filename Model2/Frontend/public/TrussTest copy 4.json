{
  "model_config": { "ndm": 2, "ndf": 2 },

  "nodes": [
    { "command": "node", "args": [1, 0.0, 0.0] },
    { "command": "node", "args": [2, 4.0, 0.0] },
    { "command": "node", "args": [3, 8.0, 0.0] },
    { "command": "node", "args": [4, 2.0, 3.0] },
    { "command": "node", "args": [5, 6.0, 3.0] }
  ],

  "boundary_conditions": [
    { "command": "fix", "args": [1, 1, 1] }, 
    { "command": "fix", "args": [3, 1, 1] }  
  ],

  "materials": [
    { "command": "uniaxialMaterial", "name": "Elastic", "args": ["Elastic", 1, 2.0e11] }
  ],

  "elements": [
    { "command": "element", "name": "truss", "args": ["truss", 1, 1, 4, 0.005, 1] },
    { "command": "element", "name": "truss", "args": ["truss", 2, 4, 2, 0.005, 1] },
    { "command": "element", "name": "truss", "args": ["truss", 3, 2, 5, 0.005, 1] },
    { "command": "element", "name": "truss", "args": ["truss", 4, 5, 3, 0.005, 1] },
    { "command": "element", "name": "truss", "args": ["truss", 5, 4, 5, 0.005, 1] },
    { "command": "element", "name": "truss", "args": ["truss", 8, 1, 2, 0.005, 1] },
    { "command": "element", "name": "truss", "args": ["truss", 9, 2, 3, 0.005, 1] }
  ],

  "time_series": [
    { "command": "timeSeries", "name": "Linear", "args": ["Linear", 1] }
  ],

  "patterns": [
    {
      "command": "pattern",
      "name": "Plain",
      "args": ["Plain", 1, 1],
      "loads": [
        { "command": "load", "args": [4, 0.0, -10000.0] },
        { "command": "load", "args": [5, 0.0, -10000.0] }
      ]
    }
  ],

  "analysis_sequence": [
    { "command": "constraints", "args": ["Transformation"] },
    { "command": "numberer", "args": ["RCM"] },
    { "command": "system", "args": ["BandGeneral"] },
    { "command": "test", "args": ["NormDispIncr", 1.0e-6, 10] },
    { "command": "algorithm", "args": ["Linear"] },
    { "command": "integrator", "name": "LoadControl", "args": ["LoadControl", 1.0] },
    { "command": "analysis", "args": ["Static"] },
    { "command": "analyze", "args": [10] }
  ],

  "recorders": [
    { "command": "recorder", "name": "Node", "args": ["Node", "-file", "node_disp.txt", "-time", "-node", 1,2,3,4,5, "-dof", 1,2, "disp"] },
    { "command": "recorder", "name": "Element", "args": ["Element", "-file", "elem_force.txt", "-time", "-ele", 1,2,3,4,5,6,7, "force"] }
  ]
}
