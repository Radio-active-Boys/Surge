{
  "model_config": { "ndm": 2, "ndf": 3 },
  "nodes": [
    { "command": "node", "args": [1, 0.0, 0.0] },
    { "command": "node", "args": [2, 0.0, 4.0] }
  ],
  "boundary_conditions": [
    { "command": "fix", "args": [1, 1, 1, 1] }
  ],
  "sections": [
    { "command": "section", "name": "Elastic", "args": [1, 2.1e11, 8.5e-5, 2e-4] }
  ],
  "transformations": [
    { "command": "geomTransf", "name": "Linear", "args": [1] }
  ],
  "elements": [
    { "command": "element", "name": "elasticBeamColumn", "args": [1, 1, 2, 8.5e-5, 2.1e11, 2e-4, 1] } 
  ],
  "time_series": [
    { "command": "timeSeries", "name": "Linear", "args": [1] }
  ],
  "patterns": [
    {
      "command": "pattern",
      "name": "Plain",
      "args": [1, 1],
      "loads": [
        { "command": "load", "args": [2, 10000, 0.0, 0.0] },
        {
          "command": "eleLoad",
          "args": [
            "-ele", 1,
            "-type", "beamUniform",
            -2000.0,
            0.0,
            0.2,
            0.9,
            4000.0,
            0.0
          ]
        }

      ]
    }
  ],
  "analysis_sequence": [
    { "command": "constraints", "args": ["Plain"] },
    { "command": "numberer", "args": ["RCM"] },
    { "command": "system", "args": ["UmfPack"] },
    { "command": "test", "args": ["NormDispIncr", 1e-6, 20] },
    { "command": "algorithm", "args": ["Newton"] },
    { "command": "integrator",  "name": "LoadControl", "args": [1] },
    { "command": "analysis", "args": ["Static"] },
    { "command": "analyze", "args": [100] }
  ],
  "recorders": [
    { "command": "recorder", "name": "Node", "args": ["-file", "node_disp.txt", "-time", "-node", 1,2, "-dof", 1,2,3, "disp"] },
    { "command": "recorder", "name": "Node", "args": ["-file", "node_reactions.txt", "-time", "-node", 1,2, "-dof", 1,2,3, "reaction"] },
    { "command": "recorder", "name": "Node", "args": ["-file", "node_vel.txt", "-time", "-node", 1,2, "-dof", 1,2,3, "vel"] },
    { "command": "recorder", "name": "Node", "args": ["-file", "node_accel.txt", "-time", "-node", 1,2, "-dof", 1,2,3, "accel"] },
    { "command": "recorder", "name": "Element", "args": ["-file", "elem_force.txt", "-time", "-ele", 1, "force"] },
    { "command": "recorder", "name": "Element", "args": ["-file", "elem_localForce.txt", "-time", "-ele", 1, "localForce"] },
    { "command": "recorder", "name": "Element", "args": ["-file", "elem_axialForce.txt", "-time", "-ele", 1, "axialForce"] },
    { "command": "recorder", "name": "Element", "args": ["-file", "elem_basicDeformation.txt", "-time", "-ele", 1, "basicDeformation"] },
    { "command": "recorder", "name": "Element", "args": ["-file", "elem_stiffness.txt", "-time", "-ele", 1, "stiffness"] }
  ]
}
